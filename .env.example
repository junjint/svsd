# Copy to .env and fill in values as needed.
# The app runs fully in demo mode without any of these.

# --- Supabase (optional — local persistence works without these) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service role key in the mobile client.
# SUPABASE_SERVICE_ROLE_KEY=  # backend / Edge Functions only

# --- Google Places (optional — use via protected backend) ---
# Prefer calling Places from a backend so the API key stays private.
EXPO_PUBLIC_PLACES_BACKEND_URL=
# GOOGLE_PLACES_API_KEY=  # backend only — do not expose in the client

# --- App behavior ---
EXPO_PUBLIC_PLACE_PROVIDER=mock
# Options: mock | google | curated | composite

EXPO_PUBLIC_DEMO_MODE=true
