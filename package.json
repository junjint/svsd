    "@supabase/supabase-js": "^2.118.0",
    "@types/leaflet": "^1.9.22",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.9",
