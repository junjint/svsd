{
  "name": "sidequest",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prototype": "expo export --platform web && npm run prototype:serve",
    "prototype:serve": "npx --yes serve --single dist -l 8080 --no-clipboard",
    "lint": "expo lint",
    "lint:prototype": "eslint src/app src/features/prototype __tests__/prototype.test.ts",
    "lint:integration": "eslint src/app src/features/navigation src/features/quest/HoldToComplete.tsx src/features/draw/result/SlideToGo.tsx src/ui/DeviceFrame.tsx src/features/draw/home/Header.tsx src/stores/sidequestStore.ts src/services/persistence __tests__/walking.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "bencho:setup": "node scripts/bencho.mjs setup",
    "bencho:check": "node scripts/bencho.mjs check",
    "bencho:diff": "node scripts/bencho.mjs diff",
    "bencho:sounds": "node scripts/bencho.mjs sounds"
  },
  "dependencies": {
    "@expo-google-fonts/archivo-black": "^0.4.1",
